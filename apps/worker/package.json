{
  "name": "@pager/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env --experimental-strip-types src/main.ts",
    "once": "PAGER_WORKER_ONCE=1 node --env-file-if-exists=../../.env --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@pager/agents": "workspace:*",
    "@pager/core": "workspace:*",
    "@pager/observability": "workspace:*",
    "@pager/providers": "workspace:*"
  }
}
